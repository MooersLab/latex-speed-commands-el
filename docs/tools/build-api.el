;;; build-api.el --- Write the API reference for latex-speed-commands -*- lexical-binding: t; -*-

;; Copyright (C) 2026 Blaine Mooers

;; This file is not part of GNU Emacs.

;;; Commentary:

;; Used by `make docs-api'.  Load the package and write a Markdown API
;; reference built from the docstrings, so that the reference never
;; drifts from the code.  The output groups the symbols into the minor
;; mode, user options, commands, public functions, and internal
;; helpers.  Each command lists its default speed keys.

;;; Code:

(require 'cl-lib)
(require 'subr-x)
(require 'lisp-mnt)
(require 'latex-speed-commands)

(defun lsc-docs--symbols ()
  "Return the functions and variables defined by the package, sorted."
  (let ((entry (cl-find-if (lambda (e)
                             (and (stringp (car e))
                                  (string-match-p "latex-speed-commands\\.elc?\\'"
                                                  (car e))))
                           load-history))
        fns vars)
    (dolist (item (cdr entry))
      (cond ((and (consp item) (eq (car item) 'defun)) (push (cdr item) fns))
            ((symbolp item) (push item vars))))
    (cons (sort fns #'string<) (sort vars #'string<))))

(defun lsc-docs--entry-target (cmd)
  "Return the command symbol that the alist entry CMD runs, or nil."
  (cond ((symbolp cmd) cmd)
        ((and (consp cmd) (eq (car cmd) 'latex-speed-commands-move-safe))
         (let ((arg (nth 1 cmd)))
           (if (eq (car-safe arg) 'quote) (nth 1 arg) arg)))))

(defun lsc-docs--keys (sym)
  "Return a description of the default speed keys that run SYM."
  (let (out)
    (dolist (spec (list (cons "heading" (eval (car (get 'latex-speed-commands
                                                        'standard-value))
                                              t))
                        (cons "environment"
                              (eval (car (get 'latex-speed-commands-environment
                                              'standard-value))
                                    t))))
      (dolist (e (cdr spec))
        (when (and (cdr e) (eq (lsc-docs--entry-target (cdr e)) sym))
          (push (format "`%s` on %s lines"
                        (if (string= (car e) " ") "SPC" (car e))
                        (car spec))
                out))))
    (when out (string-join (nreverse out) ", "))))

(defun lsc-docs--signature (fn)
  "Return the call signature of FN as a string."
  (let ((args (help-function-arglist fn t)))
    (format "(%s%s)" fn
            (if (and args (listp args))
                (concat " " (mapconcat (lambda (a) (upcase (symbol-name a)))
                                       args " "))
              ""))))

(defun lsc-docs--doc (text)
  "Return docstring TEXT as an indented Markdown code block."
  (concat "```text\n" (string-trim-right (or text "Not documented.")) "\n```\n"))

(defun lsc-docs-write-api (file)
  "Write the Markdown API reference to FILE."
  (let* ((syms (lsc-docs--symbols))
         (fns (car syms))
         (vars (cdr syms))
         (options (cl-remove-if-not #'custom-variable-p vars))
         (other-vars (cl-remove-if #'custom-variable-p vars))
         (mode 'latex-speed-commands-mode)
         (commands (cl-remove-if-not
                    (lambda (f) (and (commandp f) (not (eq f mode))))
                    fns))
         (internal (cl-remove-if-not
                    (lambda (f) (string-match-p "--" (symbol-name f))) fns))
         (public (cl-remove-if
                  (lambda (f) (or (commandp f) (memq f internal))) fns)))
    (with-temp-file file
      (insert "# latex-speed-commands API reference\n\n"
              "This file is generated by `make docs-api` from the docstrings in\n"
              "`latex-speed-commands.el`.  Do not edit it by hand.\n\n"
              (format "Version %s.\n\n" (or (ignore-errors
                                              (with-temp-buffer
                                                (insert-file-contents
                                                 (locate-library "latex-speed-commands.el"))
                                                (lm-version)))
                                            "unknown")))
      (insert "## Minor mode\n\n### " (lsc-docs--signature mode) "\n\n"
              (lsc-docs--doc (documentation mode t)) "\n")
      (insert "## User options\n\n")
      (dolist (v options)
        (insert (format "### %s\n\n" v)
                (lsc-docs--doc (documentation-property v 'variable-documentation t))
                "\n"))
      (insert "## Commands\n\n")
      (dolist (f commands)
        (let ((keys (lsc-docs--keys f)))
          (insert "### " (lsc-docs--signature f) "\n\n"
                  (if keys (format "Default speed keys: %s.\n\n" keys) "")
                  (lsc-docs--doc (documentation f t)) "\n")))
      (insert "## Functions\n\n")
      (dolist (f public)
        (insert "### " (lsc-docs--signature f) "\n\n"
                (lsc-docs--doc (documentation f t)) "\n"))
      (insert "## Internal functions and variables\n\n"
              "These may change without notice.\n\n"
              "| Symbol | Summary |\n|:--|:--|\n")
      (dolist (s (append internal other-vars))
        (let ((doc (if (fboundp s) (documentation s t)
                     (documentation-property s 'variable-documentation t))))
          (insert (format "| `%s` | %s |\n" s
                          (replace-regexp-in-string
                           "|" "\\\\|" (car (split-string (or doc "") "\n"))))))))
    (message "Wrote %s" file)))

(provide 'build-api)
;;; build-api.el ends here
